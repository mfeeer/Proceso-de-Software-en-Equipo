        { "id": "l3", "codigo": "Escribir \"Tabla del \", {n}", "sangria": 1, "padre": "l1", "despues_de": ["l2"] },
        { "id": "l4", "codigo": "Para i <- 1 Hasta 3 Hacer", "sangria": 1, "padre": "l1", "despues_de": ["l2", "l3"] },
        { "id": "l5", "codigo": "Escribir {n}, \" x \", i, \" = \", {n} * i", "sangria": 2, "padre": "l4" },
