      "consola": [
        { "texto": "Número: ", "entrada": "{e1}" },
        { "texto": "Tabla del {e1}" },
        { "texto": "{e1} x 1 = {r1}" },
        { "texto": "{e1} x 2 = {r2}" },
        { "texto": "{e1} x 3 = {r3}" }
      ]
    },
    "pseudocodigo": {
      "lineas": [
